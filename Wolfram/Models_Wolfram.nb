    Initialization:>({$CellContext`Shiftonehour[
          Pattern[$CellContext`ls, 
           Blank[List]], 
          Pattern[$CellContext`PMR, 
           Blank[]]] := 
        Module[{$CellContext`tmp}, $CellContext`tmp = $CellContext`ls; \
$CellContext`tmp = RotateRight[$CellContext`tmp]; 
          ReplacePart[$CellContext`tmp, 1 -> 
            Part[$CellContext`tmp, 1] $CellContext`PMR]]; $CellContext`im1[
          Pattern[$CellContext`PMR, 
           Blank[]], 
          Pattern[$CellContext`k, 
           Blank[]], 
          Pattern[$CellContext`lag, 
           Blank[]], 
          Pattern[$CellContext`t, 
           Blank[]]] := 
        Piecewise[{{$CellContext`PMR, $CellContext`t <= $CellContext`lag}, \
{$CellContext`PMR 
            Exp[(-$CellContext`k) ($CellContext`t - $CellContext`lag)], \
$CellContext`t > $CellContext`lag}}]; $CellContext`im2[
          Pattern[$CellContext`ls, 
           Blank[]], 
          Pattern[$CellContext`Q, 
           Blank[]]] := (1 - $CellContext`Q/
          100.) $CellContext`ls; $CellContext`MODELs[
          Pattern[$CellContext`initN, 
           Blank[]], 
          Pattern[$CellContext`LC, 
           Blank[]], 
          Pattern[$CellContext`mu, 
           Blank[]], 
          Pattern[$CellContext`sigma, 
           Blank[]], 
          Pattern[$CellContext`pmr, 
           Blank[]], 
          Pattern[$CellContext`impars, 
           Blank[List]], 
          Pattern[$CellContext`runT, 
           Blank[]]] := 
