$CellContext`temp, $CellContext`outls, $CellContext`a1, $CellContext`a2, \
$CellContext`parlen, $CellContext`k, $CellContext`lag, $CellContext`Q}, \
$CellContext`distr = Table[PDF[
                
                NormalDistribution[$CellContext`mu, $CellContext`sigma], \
$CellContext`x - $CellContext`LC]/$CellContext`pmr + PDF[
               
               NormalDistribution[$CellContext`mu, $CellContext`sigma], \
$CellContext`x] + PDF[
                
                NormalDistribution[$CellContext`mu, $CellContext`sigma], \
$CellContext`x + $CellContext`LC] $CellContext`pmr, {$CellContext`x, 
              1, $CellContext`LC}]; $CellContext`temp = 
           Chop[($CellContext`initN/
              Total[$CellContext`distr]) $CellContext`distr]; \
$CellContext`parlen = Length[$CellContext`impars]; $CellContext`outls = Part[
             Reap[
              Do[
