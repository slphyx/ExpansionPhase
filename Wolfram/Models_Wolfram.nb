   RowBox[{"Initialization", "\[RuleDelayed]", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Shiftonehour", "[", 
        RowBox[{"ls_List", ",", "PMR_"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "tmp", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"tmp", "=", "ls"}], ";", "\[IndentingNewLine]", 
          RowBox[{"tmp", "=", 
           RowBox[{"RotateRight", "[", "tmp", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ReplacePart", "[", 
           RowBox[{"tmp", ",", 
            RowBox[{"1", "\[Rule]", 
             RowBox[{
              RowBox[{"tmp", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "*", "PMR"}]}]}], "]"}]}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"im1", "[", 
        RowBox[{"PMR_", ",", "k_", ",", "lag_", ",", "t_"}], "]"}], ":=", 
       RowBox[{"Piecewise", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"PMR", ",", 
            RowBox[{"t", "\[LessEqual]", "lag"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PMR", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "k"}], " ", 
               RowBox[{"(", 
                RowBox[{"t", "-", "lag"}], ")"}]}], "]"}]}], ",", 
            RowBox[{"t", ">", "lag"}]}], "}"}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"im2", "[", 
        RowBox[{"ls_", ",", "Q_"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Q", "/", "100."}]}], ")"}], "ls"}]}], ";", "\n", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "return", " ", "age", " ", "distribution", " ", "of", " ", "each", " ",
         "time", " ", "step"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"MODELs", "[", 
        RowBox[{
        "initN_", ",", "LC_", ",", "mu_", ",", "sigma_", ",", "pmr_", ",", 
         "impars_List", ",", "runT_"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "distr", ",", "x", ",", "lst", ",", "temp", ",", "outls", ",", "a1",
            ",", "a2", ",", "parlen", ",", "k", ",", "lag", ",", "Q"}], "}"}],
          ",", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"distr", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"PDF", "[", 
                RowBox[{
                 RowBox[{"NormalDistribution", "[", 
                  RowBox[{"mu", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "//",
                "N"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "1", ",", "LC"}], "}"}]}], "]"}]}], ";"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"distr", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"PDF", "[", 
                RowBox[{
